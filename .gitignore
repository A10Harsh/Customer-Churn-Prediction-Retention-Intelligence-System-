# Local environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local configuration and secrets
.env
.env.*
!.env.example

# Data and experiment outputs
data/**
