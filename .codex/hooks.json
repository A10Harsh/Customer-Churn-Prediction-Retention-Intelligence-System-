{
  "description": "Project safeguards for churn-model data, artifacts, evaluation, and agent actions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/data_science_guard.py\"",
            "timeout": 10,
            "statusMessage": "Loading data-science safeguards"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/data_science_guard.py\"",
            "timeout": 10,
            "statusMessage": "Loading data-science safeguards"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/data_science_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking data and model safety policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/data_science_guard.py\"",
            "timeout": 30,
            "statusMessage": "Auditing model-development changes"
          }
        ]
      }
    ]
  }
}
